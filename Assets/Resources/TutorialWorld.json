    {
      "on": "button_A1:press",
      "do": [
        {
          "set": {
            "button_A1.on": true,
            "door_B1": true
          }
        },
        {
          "fx": "door_open",
          "to": "B"
        }
      ]
    },
    {
      "on": "button_B1:press",
      "do": [
        {
          "set": {
            "button_B1.on": true,
            "door_A1": true
          }
        },
        {
          "fx": "door_open",
          "to": "A"
        }
      ]
    },
    {
      "on": "keypad_B2:submit",
      "requires": {
        "code": "code_A1"
      },
      "do": [
        {
          "set": {
            "door_B2": true
          }
        },
        {
          "fx": "door_open",
          "to": "B"
        }
      ]
    },
    {
      "on": "laser_B:toggle",
      "do": [
        {
          "toggle": "laser_B.on"
        },
        {
          "toggle": "lasers_A1"
        }
      ]
    },
    {
      "on": "sprinkler_A:toggle",
      "do": [
        {
          "set": {
            "sprinkler_A.on": true,
            "fire_B1": false
          }
        },
        {
          "fx": "sprinkler_hiss",
          "to": "B"
        }
      ]
    },
    {
      "on": "breaker_B:toggle",
      "do": [
        {
          "set": {
            "breaker_B.on": true,
            "door_A3": true
          }
        },
        {
          "fx": "door_open",
          "to": "A"
        }
      ]
    },
    {
      "on": "keydoor_A:use_key",
      "requires": {
        "holding": "key"
      },
      "do": [
        {
          "set": {
            "keydoor_A.open": true
          }
        },
        {
          "consume": "key"
        }
      ]
    },
    {
      "on": "light_A:toggle",
      "do": [
        {
          "toggle": "A.dark_room.lights"
        }
      ]
    },
    {
      "on": "wall_A1:use_bomb",
      "requires": {
        "holding": "bomb"
      },
      "do": [
        {
          "set": {
            "wall_A1.broken": true
          }
        },
        {
          "consume": "bomb"
        },
        {
          "fx": "explosion",
          "to": "all"
        }
      ]
    },
    {
      "on": "drain_B:toggle",
      "do": [
        {
          "set": {
            "drain_B.on": true,
            "A.flooded_room.flooded": false
          }
        }
      ]
    },
    {
      "on": "final_A:press",
      "do": [
        {
          "set": {
            "final_A": true
          }
        }
      ]
    },
    {
      "on": "final_B:press",
