      "fire_A1": false
     }
    },
    {
     "fx": "fire_hiss",
     "at": "fire_A1"
    }
   ]
  },
  {
   "on": "final_A:press",
   "do": [
    {
     "set": {
      "final_A": true
     }
    },
    {
     "fx": "final_button"
    }
   ]
  },
  {
   "on": "wall_A3:use_bomb",
